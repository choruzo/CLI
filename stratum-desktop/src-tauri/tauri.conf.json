{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stratum",
  "version": "0.1.0",
  "identifier": "dev.stratum.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stratum",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "backgroundColor": "#0D0D0D",
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRjY2MkIwRTZCRDNEMUQKUldRZFBiM21zR0wyVHVaS3BOUTZlY05HUElEWTJMUWY5TjNNOFAwemJnTjJ1MlRwcUg4dGFuenUK",
      "endpoints": ["https://github.com/choruzo/CLI/releases/download/desktop-updater/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/stratum-core"],
    "resources": {
      "resources/sidecar/": "sidecar/"
    }
  }
}
