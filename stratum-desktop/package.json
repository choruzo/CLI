{
  "name": "stratum-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Stratum Desktop — shell Tauri v2 sobre el core de stratum-cli",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "sidecar:build": "node scripts/build-sea.mjs",
    "e2e:build": "tauri build --debug --no-bundle --features e2e",
    "e2e": "node --test --test-concurrency=1 e2e/*.e2e.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "lowlight": "^3.3.0",
    "marked": "^18.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
