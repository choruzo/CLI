{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stratum Dot",
  "version": "0.1.0",
  "identifier": "dev.stratum.dot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stratum Dot",
        "width": 440,
        "height": 680,
        "minWidth": 360,
        "minHeight": 420,
        "backgroundColor": "#0D0D0D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
