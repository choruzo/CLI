{
  "name": "stratum-dot",
  "private": true,
  "version": "0.1.0",
  "description": "Stratum Dot — cockpit nativo (Tauri v2) de stratumd, cliente del Stratum Protocol",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:native": "cargo test -p dot-link -p stratum-dot",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "smoke:real": "cargo build -p dot-link && node scripts/smoke-real.mjs",
    "smoke:chat": "cargo build -p dot-link && node scripts/smoke-chat.mjs",
    "smoke:approvals": "cargo build -p dot-link && node scripts/smoke-approvals.mjs",
    "smoke:terminal": "cargo build -p dot-link && node scripts/smoke-terminal.mjs",
    "e2e:build": "tauri build --debug --no-bundle",
    "e2e": "node e2e/dot.e2e.mjs && node e2e/chat.e2e.mjs && node e2e/approvals.e2e.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
