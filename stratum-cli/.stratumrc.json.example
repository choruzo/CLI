{
  "provider": {
    "default": "local-ollama",
    "providers": {
      "local-ollama": {
        "type": "openai-compatible",
        "baseUrl": "http://localhost:11434/v1",
        "model": "qwen3.5:9b",
        "apiKey": "ollama",
        "contextWindow": 32768,
        "timeouts": { "headersMs": 120000, "idleMs": 300000 }
      },
      "litellm-proxy": {
        "type": "openai-compatible",
        "baseUrl": "http://localhost:4000/v1",
        "model": "claude-sonnet-4-5",
        "apiKey": "${LITELLM_API_KEY}",
        "contextWindow": 200000,
        "cache": { "explicitBreakpoints": true },
        "pricing": { "input": 3, "output": 15, "cachedInput": 0.3, "cacheWrite": 3.75 }
      },
      "hosted": {
        "type": "openai-compatible",
        "baseUrl": "https://api.example.com/v1",
        "apiKey": "${EXAMPLE_API_KEY}",
        "models": {
          "big-model": {
            "contextWindow": 200000,
            "pricing": { "input": 1.5, "output": 6 }
          }
        }
      }
    }
  },
  "memory": {
    "projectFile": "./STRATUM.md",
    "globalFile": "~/.stratum/STRATUM.md",
    "decisionsFile": "./.stratum/memory/decisions.json",
    "vectorDb": "./.stratum/memory/vectors.db",
    "embeddingModel": "Xenova/all-MiniLM-L6-v2",
    "embeddingDimension": 384,
    "embeddingEndpoint": {
      "url": "http://localhost:11434/v1/embeddings",
      "model": "all-minilm",
      "apiKey": ""
    },
    "retrievalTopK": 5,
    "similarityThreshold": 0.9,
    "autoExtract": true,
    "extractionModel": "qwen3.5:9b",
    "embeddingWarmup": false,
    "session": {
      "enabled": true,
      "extractor": { "provider": "same", "model": "same" },
      "summarizer": { "provider": "same", "model": "same" },
      "allowRemote": false,
      "compactAt": 0.7,
      "targetContext": 0.45,
      "timeoutMs": 120000
    }
  },
  "context": {
    "maxTokens": "auto",
    "recent": {},
    "sessionMemory": {},
    "projectMemory": {},
    "globalMemory": {}
  },
  "tools": {
    "confirmDestructive": true,
    "bashTimeout": 30000,
    "execMaxBytes": 1048576,
    "auditLog": true,
    "jobs": {
      "enabled": true,
      "maxRunning": 8,
      "maxRetained": 50,
      "maxOutputChars": 1000000,
      "maxTotalOutputChars": 8000000,
      "readChars": 8000,
      "maxReadChars": 24000,
      "maxRuntimeMs": 1800000,
      "maxWaitMs": 60000,
      "subagentAccess": "own"
    },
    "redaction": {
      "extraPatterns": [
        {
          "value": "internal.corp.example",
          "reason": "internal domain"
        }
      ]
    },
    "testCommand": "npm test",
    "webSearch": {
      "backend": "meta",
      "tavilyApiKey": "${TAVILY_API_KEY}",
      "maxResults": 10
    },
    "webFetch": {
      "allowHosts": ["localhost:3000"]
    },
    "destructivePatterns": [
      "rm",
      "rmdir",
      "dd",
      "mkfs",
      "format",
      "DROP",
      "DELETE",
      "truncate",
      "shred",
      "wipefs"
    ],
    "guardedCommands": {
      "gitPush": "confirm",
      "gitPushForce": "confirm-always",
      "gitResetHard": "confirm",
      "gitRebase": "confirm",
      "gitBranchDeleteForce": "confirm",
      "gitCleanForce": "confirm",
      "npmPublish": "block",
      "dockerPrune": "confirm",
      "curlPipeShell": "confirm",
      "shellDetach": "block"
    },
    "sensitivePathAllowlist": []
  },
  "mcp": {
    "startup": "lazy",
    "installDir": "~/.stratum/mcp",
    "autoInstall": true,
    "heartbeatInterval": 30000,
    "servers": [
      {
        "name": "filesystem",
        "package": "@modelcontextprotocol/server-filesystem@2025.8.21",
        "args": [
          "/home/user/projects"
        ],
        "startupTimeout": 15000,
        "toolTimeout": 120000
      },
      {
        "name": "chrome-devtools",
        "package": "chrome-devtools-mcp@0.6.0"
      },
      {
        "name": "legacy-npx",
        "command": "npx",
        "args": [
          "-y",
          "some-mcp-server@latest"
        ]
      }
    ]
  },
  "agent": {
    "maxIterations": 50,
    "maxToolRetries": 3,
    "toolErrorFormat": "xml",
    "compressionKeepRounds": 6,
    "compressionTimeoutMs": 120000,
    "compressionReusePrefix": false
  },
  "agents": {
    "defaultProfile": "general",
    "maxConcurrency": 1,
    "subagentRetentionDays": 30,
    "subagentTimeoutMs": 1800000,
    "subagentMaxIterations": 50
  },
  "skills": {
    "enabled": true,
    "registryFile": "./.stratum/skill-registry.md",
    "builtin": true
  },
  "trace": {
    "enabled": true,
    "dir": "~/.stratum/traces",
    "retentionDays": 30,
    "maxFieldChars": 200000
  },
  "prompt": {
    "guides": "inline",
    "guidesDir": "./.stratum/guides"
  },
  "logging": {
    "level": "info",
    "stderr": true,
    "redact": true,
    "file": {
      "enabled": false,
      "dir": "~/.stratum/logs",
      "maxBytes": 5242880,
      "maxFiles": 5
    }
  },
  "ssh": {
    "hosts": {
      "bastion": {
        "host": "bastion.example.com",
        "port": 22,
        "user": "javi",
        "privateKey": "~/.ssh/id_ed25519"
      },
      "prod-web": {
        "host": "192.168.1.10",
        "port": 22,
        "user": "javi",
        "privateKey": "~/.ssh/id_ed25519",
        "jumpHost": "bastion",
        "confirmAll": true
      },
      "dev-server": {
        "host": "10.0.0.5",
        "port": 22,
        "user": "javi",
        "useAgent": true
      }
    }
  },
  "lsp": {
    "enabled": false,
    "timeoutMs": 3000,
    "startupTimeoutMs": 15000,
    "maxDiagnostics": 20,
    "severity": "error",
    "servers": {
      "typescript": {},
      "pyright": {}
    }
  },
  "plugins": {
    "enabled": true,
    "hookTimeoutMs": 5000,
    "setupTimeoutMs": 10000,
    "batchTimeoutMs": 15000,
    "entries": {
      "guard-env": { "path": "~/dev/guard-env/index.js", "options": { "tag": "dev" } }
    }
  },
  "daemon": {
    "idleExitMinutes": 0,
    "eventBuffer": 2000,
    "maxSessions": 16,
    "autoStart": false,
    "detachedTtlMinutes": 10,
    "approvalTimeoutMinutes": 10,
    "persistSessions": true
  },
  "desktop": {
    "maxConcurrentTurns": 2,
    "notifications": {
      "enabled": true,
      "minSeconds": 10
    },
    "globalHotkey": "CommandOrControl+Shift+Space",
    "workspaces": {
      "root": "~/.stratum/desktop/workspaces",
      "maxFileMB": 25,
      "maxWorkspaceMB": 250,
      "compressAfterDays": 7,
      "deleteAfterDays": 30
    }
  },
  "environments": {
    "prod": {
      "match": [
        "ssh:prod-*"
      ],
      "tier": "production",
      "requirePlan": true
    },
    "staging": {
      "match": [
        "ssh:stg-*"
      ],
      "tier": "staging"
    },
    "lab": {
      "match": [
        "ssh:dev-*"
      ],
      "policy": "allow"
    }
  },
  "session": {
    "profile": "auto",
    "planRetentionDays": 30,
    "profiles": {
      "ops": {
        "description": "guardias",
        "allowedTools": [
          "exec",
          "read_file",
          "grep",
          "mcp__*"
        ]
      }
    }
  }
}
