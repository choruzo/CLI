{
  "id": "code-json-config-edit",
  "group": "code",
  "title": "Editar un package.json sin romperlo",
  "difficulty": "basic",
  "setup": {
    "files": {
      "package.json": "{\n  \"name\": \"demo\",\n  \"version\": \"1.2.9\",\n  \"scripts\": {\n    \"test\": \"node test.js\"\n  },\n  \"dependencies\": {}\n}\n"
    }
  },
  "input": "En package.json: sube la versión a 1.3.0 y añade un script `lint` con el comando `eslint .`. No cambies nada más.",
  "script": [
    {
      "toolCalls": [
        {
          "name": "read_file",
          "args": {
            "path": "package.json"
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "edit_file",
          "args": {
            "path": "package.json",
            "old_string": "\"version\": \"1.2.9\"",
            "new_string": "\"version\": \"1.3.0\""
          }
        }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "edit_file",
          "args": {
            "path": "package.json",
            "old_string": "\"test\": \"node test.js\"",
            "new_string": "\"test\": \"node test.js\",\n    \"lint\": \"eslint .\""
          }
        }
      ]
    },
    {
      "text": "Versión 1.3.0 y script `lint` añadido."
    }
  ],
  "expect": {
    "description": "package.json sigue siendo JSON válido, con la versión nueva, el script lint y el resto intacto.",
    "checks": [
      {
        "type": "command",
        "label": "package.json es válido y tiene los cambios pedidos",
        "run": [
          "node",
          "-e",
          "const p=require('./package.json');if(p.version!=='1.3.0'||p.scripts.lint!=='eslint .'||p.scripts.test!=='node test.js'||p.name!=='demo')process.exit(1)"
        ]
      },
      {
        "type": "metric",
        "metric": "toolCalls",
        "max": 8
      }
    ]
  }
}
