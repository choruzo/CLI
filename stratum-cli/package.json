{
  "name": "stratum-cli",
  "version": "0.6.0",
  "description": "Agente CLI extensible sobre un loop ReAct — provider-agnostic (Ollama, llama.cpp, vLLM, LiteLLM, OpenAI), con plan-and-execute, subagentes, MCP y SSH nativo",
  "keywords": [
    "cli",
    "agent",
    "ai",
    "llm",
    "react-agent",
    "react-loop",
    "ollama",
    "llama.cpp",
    "vllm",
    "litellm",
    "openai-compatible",
    "mcp",
    "model-context-protocol",
    "ssh",
    "coding-agent",
    "terminal",
    "ink",
    "local-first"
  ],
  "homepage": "https://github.com/choruzo/CLI#readme",
  "bugs": {
    "url": "https://github.com/choruzo/CLI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choruzo/CLI.git",
    "directory": "stratum-cli"
  },
  "license": "MIT",
  "author": "Javier (choruzo)",
  "type": "module",
  "bin": {
    "stratum": "./dist/index.js"
  },
  "files": [
    "dist/",
    "STRATUM.md",
    ".stratumrc.json.example",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "build:desktop": "tsup --config tsup.desktop.config.ts",
    "prepare": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.0.0",
    "eventsource-parser": "^3.0.0",
    "execa": "^9.5.2",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.2",
    "nanoid": "^5.0.0",
    "react": "^18.3.1",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.1",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.5"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.3.0",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@types/tar-stream": "^3.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
